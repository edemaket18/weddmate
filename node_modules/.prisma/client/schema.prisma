// Schéma Prisma — Plateforme de coordination mariage
// Stack : PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum Role {
  COUPLE // Les mariés
  PRESTATAIRE // Photographe, traiteur, DJ...
  PLANNER // Wedding planner professionnel
  ADMIN // Administrateur de la plateforme
}

enum WeddingStatus {
  EN_PREPARATION
  CONFIRME
  TERMINE
  ANNULE
}

enum PrestaireStatut {
  CONTACTE // Premier contact établi
  EN_ATTENTE // Devis demandé, en attente de réponse
  CONFIRME // Contrat signé / accord verbal confirmé
  PAYE // Acompte ou solde payé
  ANNULE // Contrat annulé
}

enum PrestaireCategorie {
  LIEU
  TRAITEUR
  PHOTOGRAPHE
  VIDEASTE
  DJ_MUSIQUE
  ORCHESTRE
  FLEURISTE
  DECORATION
  OFFICIANT
  COIFFURE_MAQUILLAGE
  TRANSPORT
  GATEAU
  ANIMATION
  AUTRE
}

enum BudgetStatut {
  PREVU // Montant estimé, pas encore payé
  ACOMPTE // Acompte versé
  SOLDE // Entièrement payé
}

enum InviteStatut {
  EN_ATTENTE // Invitation envoyée, pas de réponse
  CONFIRME // A confirmé sa présence
  DECLINE // A décliné
  LISTE_ATTENTE
}

enum RappelType {
  ACOMPTE_DU // Rappel paiement acompte
  SOLDE_DU // Rappel paiement solde
  CONFIRMATION // Demande de confirmation de prestation
  DOCUMENTS // Documents manquants
  JOUR_J_MOINS_30
  JOUR_J_MOINS_7
  JOUR_J_MOINS_1
  RSVP_INVITE_J7 // Rappel WhatsApp envoyé aux invités confirmés J-7
  PERSONNALISE
}

enum RappelStatut {
  PROGRAMME
  ENVOYE
  ECHEC
}

enum NotifCanal {
  WHATSAPP
  EMAIL
  SMS
}

// UTILISATEUR

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  telephone  String?  @unique
  motDePasse String
  nom        String
  prenom     String
  role       Role     @default(COUPLE)
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  weddingsCouple  WeddingCouple[] // Mariages où l'user est l'un des mariés
  weddingsPlanner Wedding[]       @relation("PlannerWeddings")
  prestataire     Prestataire? // Si l'user est un prestataire
  notifications   Notification[]
  sessionsActives Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// MARIAGE

model Wedding {
  id             String        @id @default(cuid())
  nomCeremonie   String // Ex: "Mariage Koffi & Ama"
  slug           String        @unique // Ex: "koffi-ama-xk39p" — utilisé dans les URLs publiques
  dateJourJ      DateTime
  heureCeremonie String? // Ex: "10h00"
  heureReception String? // Ex: "13h00"
  lieuCeremonie  String?
  lieuReception  String?
  statut         WeddingStatus @default(EN_PREPARATION)
  budgetTotal    Float         @default(0)
  devise         String        @default("FCFA")
  nombreInvites  Int           @default(0)
  notes          String?

  // Flags RSVP & galerie
  rsvpOuvert     Boolean   @default(false) // Les mariés activent le formulaire public
  galerieOuverte Boolean   @default(false) // Activé après le mariage pour partager les photos
  rsvpDateLimite DateTime? // Date limite pour répondre au RSVP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Wedding planner optionnel
  plannerId String?
  planner   User?   @relation("PlannerWeddings", fields: [plannerId], references: [id])

  // Relations
  couples       WeddingCouple[]
  prestataires  WeddingPrestataire[]
  budgetItems   BudgetItem[]
  invites       Invite[]
  taches        Tache[]
  rappels       Rappel[]
  documents     Document[]
  notifications Notification[]
  photosGalerie PhotoGalerie[]

  @@map("weddings")
}

// Table de jonction pour les couples (2 mariés par mariage)
model WeddingCouple {
  id        String   @id @default(cuid())
  weddingId String
  userId    String
  role      String   @default("MARIE") // MARIE ou MARIEE ou autre
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId])
  @@map("wedding_couples")
}

// PRESTATAIRE

model Prestataire {
  id            String             @id @default(cuid())
  userId        String?            @unique // Si le prestataire a un compte
  nomEntreprise String
  nomContact    String
  telephone     String
  email         String?
  whatsapp      String?
  categorie     PrestaireCategorie
  description   String?
  siteWeb       String?
  ville         String?
  noteGlobale   Float?             @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user         User?                @relation(fields: [userId], references: [id])
  weddingsLies WeddingPrestataire[]
  evaluations  Evaluation[]

  @@map("prestataires")
}

// Liaison prestataire <-> mariage avec toutes les infos du contrat
model WeddingPrestataire {
  id               String          @id @default(cuid())
  weddingId        String
  prestataireId    String
  statut           PrestaireStatut @default(CONTACTE)
  montantDevis     Float?
  montantAcompte   Float?
  dateAcompte      DateTime?
  montantSolde     Float?
  dateSolde        DateTime?
  heureArrivee     DateTime?
  heureDepart      DateTime?
  lieuIntervention String?
  notesContrat     String?
  ficheConfirmee   Boolean         @default(false) // Prestataire a confirmé ses infos
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  wedding     Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  prestataire Prestataire @relation(fields: [prestataireId], references: [id])
  rappels     Rappel[]

  @@unique([weddingId, prestataireId])
  @@map("wedding_prestataires")
}

// BUDGET

model BudgetItem {
  id           String             @id @default(cuid())
  weddingId    String
  categorie    PrestaireCategorie
  libelle      String // Ex: "Traiteur Kossivi"
  montantPrevu Float              @default(0)
  montantPaye  Float              @default(0)
  statut       BudgetStatut       @default(PREVU)
  datePaiement DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("budget_items")
}

// INVITÉS

model Invite {
  id            String       @id @default(cuid())
  weddingId     String
  nom           String
  prenom        String
  telephone     String?
  email         String?
  whatsapp      String?
  statut        InviteStatut @default(EN_ATTENTE)
  nombreAccompa Int          @default(0) // Accompagnants inclus
  tableAssignee String? // Numéro/nom de table
  regimeAliment String? // Végétarien, halal, allergie...
  transport     Boolean      @default(false) // Besoin de transport
  hebergement   Boolean      @default(false) // Besoin d'hébergement
  cote          String? // "MARIE" ou "MARIEE"
  notes         String?

  // Champs RSVP (remplis via le formulaire public)
  messageAuxMaries String? // Message laissé par l'invité à la soumission
  rsvpAt           DateTime? // Horodatage de la réponse RSVP
  rsvpSource       String? // "lien" ou "manuel" (ajout direct par les mariés)
  rappelJ7Envoye   Boolean   @default(false) // Rappel WhatsApp J-7 déjà envoyé ?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("invites")
}

// TÂCHES & CHECKLIST

model Tache {
  id          String    @id @default(cuid())
  weddingId   String
  titre       String
  description String?
  echeance    DateTime?
  faite       Boolean   @default(false)
  priorite    Int       @default(2) // 1=haute, 2=normale, 3=basse
  categorie   String? // "Administratif", "Décoration", etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("taches")
}

// RAPPELS AUTOMATIQUES (WhatsApp)

model Rappel {
  id                   String       @id @default(cuid())
  weddingId            String
  weddingPrestataireId String? // Si rappel lié à un prestataire précis
  type                 RappelType
  canal                NotifCanal   @default(WHATSAPP)
  destinataire         String // Numéro WhatsApp ou email
  messagePersonna      String? // Message custom si type = PERSONNALISE
  dateEnvoi            DateTime // Quand envoyer ce rappel
  statut               RappelStatut @default(PROGRAMME)
  erreurMessage        String? // En cas d'échec d'envoi
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  wedding            Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingPrestataire WeddingPrestataire? @relation(fields: [weddingPrestataireId], references: [id])

  @@map("rappels")
}

// DOCUMENTS (contrats, devis, photos...)

model Document {
  id        String   @id @default(cuid())
  weddingId String
  nom       String
  type      String // "contrat", "devis", "photo", "autre"
  url       String // URL Supabase Storage
  taille    Int? // En octets
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ÉVALUATIONS PRESTATAIRES (post-mariage)

model Evaluation {
  id            String   @id @default(cuid())
  prestataireId String
  weddingId     String
  note          Int // 1 à 5
  commentaire   String?
  createdAt     DateTime @default(now())

  prestataire Prestataire @relation(fields: [prestataireId], references: [id])

  @@unique([prestataireId, weddingId])
  @@map("evaluations")
}

// GALERIE PHOTO (accessible via QR Code après le mariage)

model PhotoGalerie {
  id           String   @id @default(cuid())
  weddingId    String
  url          String // URL Supabase Storage
  thumbnailUrl String? // Version réduite pour l'affichage en grille
  taille       Int? // En octets
  uploadePar   String? // Nom de l'invité uploadeur (anonyme si non connecté)
  whatsappUpl  String? // Numéro WhatsApp de l'uploadeur (optionnel)
  validee      Boolean  @default(true) // Les mariés peuvent masquer une photo
  caption      String? // Légende optionnelle
  createdAt    DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("photos_galerie")
}

// NOTIFICATIONS IN-APP

model Notification {
  id        String   @id @default(cuid())
  userId    String
  weddingId String?
  titre     String
  message   String
  lue       Boolean  @default(false)
  lien      String? // Route de l'app pour naviguer
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding Wedding? @relation(fields: [weddingId], references: [id])

  @@map("notifications")
}
